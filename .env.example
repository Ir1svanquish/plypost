# Copy to .env.local. These values are read only by server-side route handlers.
# Configure either provider, or both.
NEBIUS_API_KEY=
NEBIUS_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Required for owner sign-in. Generate the hash with npm run hash-password.
PLYPOST_OWNER_EMAIL=
PLYPOST_OWNER_PASSWORD_HASH=
# Optional persistent SQLite location. The default ./data/plypost.sqlite is Git-ignored.
PLYPOST_DB_PATH=

# Optional Mastodon live text posting. Leave these blank to keep it disabled.
# Use the exact HTTPS origin of your Mastodon instance (no path or trailing slash).
PLYPOST_MASTODON_INSTANCE=
# Exact public origin of this Plypost app. Local testing may use http://127.0.0.1:3000.
PLYPOST_PUBLIC_ORIGIN=
# 32 random bytes as 64 hex characters; generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PLYPOST_MASTODON_SECRET=
