# Copy to .env.local. These values are read only by server-side route handlers.
# Nebius Token Factory serves the NVIDIA Nemotron text and vision models used by optional AI tools.
NEBIUS_API_KEY=
# Optional shared rolling 24-hour cap for AI tools (1-240). Leave blank for hourly limit only.
PLYPOST_AI_DAILY_LIMIT=

# Required for owner sign-in. Generate the hash with npm run hash-password.
PLYPOST_OWNER_EMAIL=
PLYPOST_OWNER_PASSWORD_HASH=
# Optional persistent SQLite location. The default ./data/plypost.sqlite is Git-ignored.
PLYPOST_DB_PATH=

# Optional Mastodon live text posting and individually confirmed real scheduling.
# Leave connection values blank to keep Mastodon live publishing unavailable.
# Use the exact HTTPS origin of your Mastodon instance (no path or trailing slash).
PLYPOST_MASTODON_INSTANCE=
# Exact public origin of this Plypost app. Local testing may use http://127.0.0.1:3000.
PLYPOST_PUBLIC_ORIGIN=
# 32 random bytes as 64 hex characters; generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PLYPOST_MASTODON_SECRET=
# Optional pause for new real schedules and future worker dispatch. Default is enabled.
# Changing this value requires restarting both the web app and worker.
PLYPOST_MASTODON_SCHEDULE_ENABLED=true

# Optional local-only Bluesky OAuth and immediate plain-text posting foundation.
# Use the exact address you open in the browser, e.g. http://127.0.0.1:3000.
# Public HTTPS OAuth metadata/client registration is not implemented yet.
PLYPOST_BLUESKY_ORIGIN=
# Independent 32-byte key (64 hex characters) for encrypted OAuth state and sessions.
PLYPOST_BLUESKY_SECRET=
